module

public import Cslib.Computability.Automata.MPDA.Basic

/-! # Well-nested runs of multistack pushdown automata

A sequence of transitions is well-nested when every push has a matching pop later in the sequence,
every pop has a matching push earlier in the sequence, and matching pairs do not cross. Following
[AkshayGastinKrishnaRoychowdhury2020], well-nested sequences are generated by sequences of `nop`
transitions, by surrounding a well-nested sequence with a matching push and pop on the same stack
and with the same symbol, and by concatenation.

Well-nested runs are the building block of the reachability algorithm of
[AkshayGastinKrishnaRoychowdhury2020]. Its first phase saturates the relation `WellNestedReach`,
and Lemma 1 of the paper states that this relation is exactly reachability by well-nested runs.

## Main definitions

- `MPDA.WellNested`: well-nested sequences of transition labels.
- `MPDA.WellNestedReach`: the least relation on control states that contains the identity, is
  closed under prefixing `nop` transitions, and under prefixing a matching push/pop pair.

## Main statements

- `MPDA.WellNested.append`: well-nested sequences are closed under concatenation.
- `MPDA.WellNested.configLTS_mTr_iff`: a well-nested run of the control lifts to a run on
  configurations from any stack contents to the same stack contents, and conversely.
- `MPDA.wellNestedReach_iff`: Lemma 1 of [AkshayGastinKrishnaRoychowdhury2020].
- `MPDA.accepts_of_wellNestedReach`: if an accepting state is well-nested reachable from an initial
  state, the MPDA accepts some word.

## Implementation notes

The paper seeds the saturation with the `nop` transitions and closes it under transitive closure,
which yields a relation that is not reflexive. We include the identity, which corresponds to the
empty well-nested sequence. Without it, Lemma 1 fails for the empty run.

## References

* [S. Akshay, P. Gastin, S. Krishna, S. Roychowdhury,
  *Revisiting Underapproximate Reachability for Multipushdown Systems*]
  [AkshayGastinKrishnaRoychowdhury2020]
-/

@[expose] public section

namespace Cslib.Automata.MPDA

variable {n : ℕ} {State Symbol Γ : Type*}

/-- A sequence of transition labels is well-nested if it is generated by the empty sequence,
prefixing a `nop`, and surrounding a well-nested sequence by a matching push and pop, followed
by another well-nested sequence. -/
inductive WellNested : List (Symbol × Op n Γ) → Prop where
  | nil : WellNested []
  | nop {a : Symbol} {w : List (Symbol × Op n Γ)} : WellNested w → WellNested ((a, .nop) :: w)
  | pushPop {a b : Symbol} {i : Fin n} {γ : Γ} {w w' : List (Symbol × Op n Γ)} :
    WellNested w → WellNested w' → WellNested ((a, .push i γ) :: (w ++ (b, .pop i γ) :: w'))

namespace WellNested

attribute [scoped grind .] WellNested.nil

/-- Well-nested sequences are closed under concatenation. -/
theorem append {w w' : List (Symbol × Op n Γ)} (h : WellNested w) (h' : WellNested w') :
    WellNested (w ++ w') := by
  induction h with
  | nil => exact h'
  | nop _ ih => exact .nop ih
  | pushPop h₁ _ _ ih₂ =>
    rw [List.cons_append, List.append_assoc, List.cons_append]
    exact .pushPop h₁ ih₂

/-- Every sequence of `nop` transitions is well-nested. -/
theorem of_forall_nop {w : List (Symbol × Op n Γ)} (h : ∀ μ ∈ w, μ.2 = .nop) : WellNested w := by
  induction w with
  | nil => exact .nil
  | cons μ w ih =>
    obtain ⟨a, op⟩ := μ
    have hop : op = .nop := h _ List.mem_cons_self
    subst hop
    exact .nop (ih fun μ hμ => h μ (List.mem_cons_of_mem _ hμ))

variable {M : MPDA n State Symbol Γ}

/-- A well-nested run on configurations leaves the stacks unchanged. -/
theorem stacks_eq {w : List (Symbol × Op n Γ)} (hw : WellNested w)
    {c c' : Config n State Γ} (h : M.configLTS.MTr c w c') : c'.contents = c.contents := by
  induction hw generalizing c c' with
  | nil => rw [LTS.MTr.nil_eq _ h]
  | nop _ ih =>
    obtain ⟨c₁, ⟨_, happ⟩, hrest⟩ := LTS.MTr.cons_iff.mp h
    rw [ih hrest]
    exact happ
  | @pushPop a b i γ w w' _ _ ih ih' =>
    obtain ⟨c₁, ⟨_, hpush⟩, hrest⟩ := LTS.MTr.cons_iff.mp h
    obtain ⟨c₂, hw, hrest⟩ := LTS.MTr.split hrest
    obtain ⟨c₃, ⟨_, hpop⟩, hw'⟩ := LTS.MTr.cons_iff.mp hrest
    rw [ih' hw']
    have h₂ : c₂.contents = c₁.contents := ih hw
    simp only [Op.apply_push] at hpush
    simp only [Op.apply_pop] at hpop
    rw [h₂, hpush] at hpop
    funext j
    by_cases hj : j = i
    · subst hj
      have := congrFun hpop j
      simp only [Function.update_self, List.cons.injEq, true_and] at this
      exact this.symm
    · have := congrFun hpop j
      simp only [ne_eq, hj, not_false_eq_true, Function.update_of_ne] at this
      exact this.symm

/-- A well-nested run of the control lifts to a run on configurations that starts and ends with
the same, arbitrary, stack contents. -/
theorem configLTS_mTr {w : List (Symbol × Op n Γ)} (hw : WellNested w)
    {s s' : State} (h : M.MTr s w s') (σ : Stacks n Γ) :
    M.configLTS.MTr ⟨s, σ⟩ w ⟨s', σ⟩ := by
  induction hw generalizing s s' σ with
  | nil =>
    rw [LTS.MTr.nil_eq _ h]
    exact .refl
  | nop _ ih =>
    obtain ⟨s₁, htr, hrest⟩ := LTS.MTr.cons_iff.mp h
    have hnop : M.configLTS.Tr ⟨s, σ⟩ (_, .nop) ⟨s₁, σ⟩ := ⟨htr, rfl⟩
    exact .stepL hnop (ih hrest σ)
  | @pushPop a b i γ w w' _ _ ih ih' =>
    obtain ⟨s₁, hpush, hrest⟩ := LTS.MTr.cons_iff.mp h
    obtain ⟨s₂, hw, hrest⟩ := LTS.MTr.split hrest
    obtain ⟨s₃, hpop, hw'⟩ := LTS.MTr.cons_iff.mp hrest
    let σ₁ := Function.update σ i (γ :: σ i)
    have hpop' : M.configLTS.Tr ⟨s₂, σ₁⟩ (b, .pop i γ) ⟨s₃, σ⟩ := by
      refine ⟨hpop, ?_⟩
      simp only [Op.apply_pop, σ₁]
    have hpush' : M.configLTS.Tr ⟨s, σ⟩ (a, .push i γ) ⟨s₁, σ₁⟩ := ⟨hpush, rfl⟩
    exact .stepL hpush' ((ih hw σ₁).comp _ (.stepL hpop' (ih' hw' σ)))

/-- A well-nested sequence labels a run on configurations exactly when it labels a run of the
control, and the stacks are left unchanged. -/
theorem configLTS_mTr_iff {w : List (Symbol × Op n Γ)} (hw : WellNested w)
    {c c' : Config n State Γ} :
    M.configLTS.MTr c w c' ↔ M.MTr c.state w c'.state ∧ c'.contents = c.contents := by
  constructor
  · intro h
    exact ⟨configLTS_mTr_state h, hw.stacks_eq h⟩
  · rintro ⟨h, hσ⟩
    obtain ⟨s, σ⟩ := c
    obtain ⟨s', σ'⟩ := c'
    simp only at hσ
    subst hσ
    exact hw.configLTS_mTr h _

end WellNested

/-- Well-nested reachability between control states: the least relation containing the identity
and closed under prefixing a `nop` transition, and under prefixing a push, a well-nested segment,
and the matching pop. This is the relation `WR` computed by the saturation procedure
`WellNestedReach` of [AkshayGastinKrishnaRoychowdhury2020]. -/
inductive WellNestedReach (M : MPDA n State Symbol Γ) : State → State → Prop where
  | refl (s : State) : WellNestedReach M s s
  | nop {s₁ s₂ s₃ : State} {a : Symbol} :
    M.Tr s₁ (a, .nop) s₂ → WellNestedReach M s₂ s₃ → WellNestedReach M s₁ s₃
  | pushPop {s₁ s₂ s₃ s₄ s₅ : State} {a b : Symbol} {i : Fin n} {γ : Γ} :
    M.Tr s₁ (a, .push i γ) s₂ → WellNestedReach M s₂ s₃ → M.Tr s₃ (b, .pop i γ) s₄ →
    WellNestedReach M s₄ s₅ → WellNestedReach M s₁ s₅

variable {M : MPDA n State Symbol Γ}

/-- Lemma 1 of [AkshayGastinKrishnaRoychowdhury2020]: `s'` is well-nested reachable from `s`
exactly when there is a well-nested run of the control from `s` to `s'`. -/
theorem wellNestedReach_iff {s s' : State} :
    M.WellNestedReach s s' ↔ ∃ w : List (Symbol × Op n Γ), WellNested w ∧ M.MTr s w s' := by
  constructor
  · intro h
    induction h with
    | refl s => exact ⟨[], .nil, .refl⟩
    | nop htr _ ih =>
      obtain ⟨w, hw, hrun⟩ := ih
      exact ⟨_, .nop hw, .stepL htr hrun⟩
    | pushPop hpush _ hpop _ ih ih' =>
      obtain ⟨w, hw, hrun⟩ := ih
      obtain ⟨w', hw', hrun'⟩ := ih'
      exact ⟨_, .pushPop hw hw', .stepL hpush (hrun.comp _ (.stepL hpop hrun'))⟩
  · rintro ⟨w, hw, hrun⟩
    induction hw generalizing s s' with
    | nil =>
      rw [LTS.MTr.nil_eq _ hrun]
      exact .refl _
    | nop _ ih =>
      obtain ⟨s₁, htr, hrest⟩ := LTS.MTr.cons_iff.mp hrun
      exact .nop htr (ih hrest)
    | pushPop _ _ ih ih' =>
      obtain ⟨s₁, hpush, hrest⟩ := LTS.MTr.cons_iff.mp hrun
      obtain ⟨s₂, hw, hrest⟩ := LTS.MTr.split hrest
      obtain ⟨s₃, hpop, hw'⟩ := LTS.MTr.cons_iff.mp hrest
      exact .pushPop hpush (ih hw) hpop (ih' hw')

/-- Well-nested reachability between control states lifts to configurations with any stack
contents. -/
theorem WellNestedReach.exists_configLTS_mTr {s s' : State} (h : M.WellNestedReach s s')
    (σ : Stacks n Γ) : ∃ w, WellNested w ∧ M.configLTS.MTr ⟨s, σ⟩ w ⟨s', σ⟩ := by
  obtain ⟨w, hw, hrun⟩ := wellNestedReach_iff.mp h
  exact ⟨w, hw, hw.configLTS_mTr hrun σ⟩

/-- Soundness of the first check of the emptiness algorithm of
[AkshayGastinKrishnaRoychowdhury2020]: if an accepting state is well-nested reachable from an
initial state, the MPDA accepts some word. -/
theorem accepts_of_wellNestedReach {s s' : State} (hs : s ∈ M.start) (hs' : s' ∈ M.accept)
    (h : M.WellNestedReach s s') : ∃ xs, Acceptor.Accepts M xs := by
  obtain ⟨w, _, hrun⟩ := h.exists_configLTS_mTr Stacks.empty
  exact ⟨w.map Prod.fst, s, hs, s', hs', w, rfl, hrun⟩

end Cslib.Automata.MPDA
