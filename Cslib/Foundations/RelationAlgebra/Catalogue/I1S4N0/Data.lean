module

public import Cslib.Foundations.RelationAlgebra.FastCatalogueProfiles
public import Mathlib.Data.Fin.VecNotation

/-!
# Cycle-profile data for the ⟨1, 4, 0⟩ classification

Models are ordered by increasing canonical cycle mask. These indices are generated from
Peircean orbit choices, rather than source entry numbers. Packed profiles record every atom
renaming and are linked to the actual cycle tables by the model certificate modules.
-/

@[expose] public section

namespace Cslib.RelationAlgebra.Catalogue.I1S4N0.Data

set_option maxRecDepth 8192

/-- The lexicographically ordered representatives of the diversity-cycle orbits. -/
def cycleReps : Fin 20 → Cycle 4 0 :=
  ![(.inl 0, .inl 0, .inl 0),
    (.inl 0, .inl 0, .inl 1),
    (.inl 0, .inl 0, .inl 2),
    (.inl 0, .inl 0, .inl 3),
    (.inl 0, .inl 1, .inl 1),
    (.inl 0, .inl 1, .inl 2),
    (.inl 0, .inl 1, .inl 3),
    (.inl 0, .inl 2, .inl 2),
    (.inl 0, .inl 2, .inl 3),
    (.inl 0, .inl 3, .inl 3),
    (.inl 1, .inl 1, .inl 1),
    (.inl 1, .inl 1, .inl 2),
    (.inl 1, .inl 1, .inl 3),
    (.inl 1, .inl 2, .inl 2),
    (.inl 1, .inl 2, .inl 3),
    (.inl 1, .inl 3, .inl 3),
    (.inl 2, .inl 2, .inl 2),
    (.inl 2, .inl 2, .inl 3),
    (.inl 2, .inl 3, .inl 3),
    (.inl 3, .inl 3, .inl 3)]

/-- The basis meets every diversity-cycle orbit. -/
theorem cycleReps_cover : ∀ c : Cycle 4 0,
    ∃ i, (some c.1, some c.2.1, some c.2.2) ∈ cycleOrbit (cycleReps i) := by
  decide +kernel

/-- No two basis cycles lie in the same orbit. -/
theorem cycleReps_distinct : ∀ i l,
    (some (cycleReps i).1, some (cycleReps i).2.1, some (cycleReps i).2.2) ∈
      cycleOrbit (cycleReps l) ↔ i = l := by
  decide +kernel

/-- The converse-preserving permutations of the diversity atoms. -/
def renameDiversity (p : Fin 24) : DiversityAtom 4 0 → DiversityAtom 4 0
  | .inl 0 =>
    ![.inl 0, .inl 0, .inl 0, .inl 0,
      .inl 0, .inl 0, .inl 1, .inl 1,
      .inl 1, .inl 1, .inl 1, .inl 1,
      .inl 2, .inl 2, .inl 2, .inl 2,
      .inl 2, .inl 2, .inl 3, .inl 3,
      .inl 3, .inl 3, .inl 3, .inl 3] p
  | .inl 1 =>
    ![.inl 1, .inl 1, .inl 2, .inl 2,
      .inl 3, .inl 3, .inl 0, .inl 0,
      .inl 2, .inl 2, .inl 3, .inl 3,
      .inl 0, .inl 0, .inl 1, .inl 1,
      .inl 3, .inl 3, .inl 0, .inl 0,
      .inl 1, .inl 1, .inl 2, .inl 2] p
  | .inl 2 =>
    ![.inl 2, .inl 3, .inl 1, .inl 3,
      .inl 1, .inl 2, .inl 2, .inl 3,
      .inl 0, .inl 3, .inl 0, .inl 2,
      .inl 1, .inl 3, .inl 0, .inl 3,
      .inl 0, .inl 1, .inl 1, .inl 2,
      .inl 0, .inl 2, .inl 0, .inl 1] p
  | .inl 3 =>
    ![.inl 3, .inl 2, .inl 3, .inl 1,
      .inl 2, .inl 1, .inl 3, .inl 2,
      .inl 3, .inl 0, .inl 2, .inl 0,
      .inl 3, .inl 1, .inl 3, .inl 0,
      .inl 1, .inl 0, .inl 2, .inl 1,
      .inl 2, .inl 0, .inl 1, .inl 0] p

/-- Extend a diversity-atom permutation by fixing the identity atom. -/
def rename (p : Fin 24) : Atom 4 0 → Atom 4 0 := Option.map (renameDiversity p)

/-- All listed atom renamings preserve identity and converse and are injective. -/
theorem rename_laws : ∀ p, Function.Injective (rename p) ∧ rename p none = none ∧
    ∀ x, rename p x.converse = (rename p x).converse := by
  decide +kernel

/-- The listed renamings include every injective identity- and converse-preserving map. -/
theorem renamings_exhaustive : ∀ f : Atom 4 0 → Atom 4 0,
    Function.Injective f → f none = none →
      (∀ x, f x.converse = (f x).converse) → ∃ p : Fin 24, f = rename p := by
  unfold Function.Injective
  decide +kernel

/-- Renaming zero is the identity. -/
theorem rename_zero : ∀ x, rename 0 x = x := by decide +kernel

