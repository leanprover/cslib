  else 0

/-- A bounded numeric table decoded from packed blocks. -/
noncomputable def equationCoverValues (i : ℕ) : ℕ :=
  if Nat.blt i 1296 then
    Code.field (equationCoverValuesBlocks (Nat.shiftRight i 5)) (Nat.land i 31 * 7) 7
  else 74

/-- Map every atom quadruple to its retained equation, with a tautology sentinel. -/
noncomputable def equationCover (a b c d : ℕ) : ℕ :=
  equationCoverValues (((a * 6 + b) * 6 + c) * 6 + d)

/-- Every retained equation comes from atomic associativity. -/
theorem sources_checked :
    Search.sourcesCheck 6 74 slots equations sourceQuads = true := by
  decide +kernel

private noncomputable def equationPairCover (a b : ℕ) : Bool :=
  Code.allBelow (fun c => Code.allBelow (fun d =>
    let eqn := Search.compileEquation 6 slots (a, b, c, d)
    eqn.left.beq eqn.right ||
      (Nat.blt (equationCover a b c d) 74 &&
        (equations (equationCover a b c d)).same eqn)) 6) 6

