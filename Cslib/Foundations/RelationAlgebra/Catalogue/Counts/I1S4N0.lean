/-- Bounded lookup through closed balanced data. -/
noncomputable def cycleRepValues (i : ℕ) : Cycle 4 0 :=
  if Nat.blt i 20 then
    Search.LookupTree.get ((.inl 0, .inl 0, .inl 0)) cycleRepValuesTree i
  else (.inl 0, .inl 0, .inl 0)

/-- Representatives of the Peircean orbits, in the search's branching order. -/
noncomputable def cycleReps (i : Fin 20) : Cycle 4 0 := cycleRepValues i

/-- The basis meets every diversity-cycle orbit. -/
theorem cycleReps_cover : ∀ c : Cycle 4 0,
    ∃ i, (some c.1, some c.2.1, some c.2.2) ∈ cycleOrbit (cycleReps i) := by
  decide +kernel

/-- Different basis indices describe disjoint Peircean orbits. -/
theorem cycleReps_distinct : ∀ i l,
    (some (cycleReps i).1, some (cycleReps i).2.1, some (cycleReps i).2.2) ∈
      cycleOrbit (cycleReps l) ↔ i = l := by
  decide +kernel

