/-- Numeric slots for every atom triple, including forced identity cycles. -/
noncomputable def slots (a b c : ℕ) : ℕ :=
  slotValues (Code.index 5 a b c)

/-- The slot representation agrees with cycle closure. -/
theorem slots_spec : CycleSlots cycleReps slots := by
  decide +kernel

