/-- Bounded lookup through closed balanced data. -/
noncomputable def bundleReasonCodesBlocks (i : ℕ) : ℕ :=
  if Nat.blt i 34 then
    Search.LookupTree.get (0) bundleReasonCodesBlocksTree i
  else 0

/-- Bounded lookup through the adaptive-width packed blocks. -/
noncomputable def bundleReasonCodes (i : ℕ) : ℕ :=
  if Nat.blt i 1057 then
    let block := bundleReasonCodesBlocks (Nat.shiftRight i 5)
    let width := Code.field block 0 9
    Code.field block (9 + Nat.land i 31 * width) width
  else 0

/-- The positive reasons used to validate one cached retirement bundle. -/
noncomputable def bundleReasons (i : ℕ) : List ℕ :=
  let code := bundleReasonCodes i
  Search.decodeBundleIndices 11 (Code.field code 0 5)
    (Nat.shiftRight code 5)

/-- Decode the masks used by one retirement step. -/
noncomputable def bundleData (i : ℕ) : Search.BundleData :=
  let code := bundleCodes i
  ⟨Code.field code 0 45, Code.field code 45 20,
    Code.field code 65 20⟩

/-- Consecutive retirements certified by unions of independently checked reasons. -/
noncomputable def bundles : Search.BundleTable where
  size := 1057
  lookup := bundleData
  reasons := bundleReasons

private theorem bundleBlock000_checked :
    bundles.checkBlock reasons 256 0 = true := by
  decide +kernel

private theorem bundleBlock001_checked :
    bundles.checkBlock reasons 256 1 = true := by
