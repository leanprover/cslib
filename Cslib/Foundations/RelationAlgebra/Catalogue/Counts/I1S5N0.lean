private noncomputable def equationPairCover (a b : ℕ) : Bool :=
  Code.allBelow (fun c => Code.allBelow (fun d =>
    let eqn := Search.compileEquation 6 slots (a, b, c, d)
    eqn.left.beq eqn.right ||
      (Nat.blt (equationCover a b c d) 55 &&
        (equations (equationCover a b c d)).same eqn)) 6) 6

