/-- Bounded lookup through closed balanced data. -/
noncomputable def renameAtom5 (i : ℕ) : DiversityAtom 5 0 :=
  if Nat.blt i 120 then
    Search.LookupTree.get (.inl 4) renameAtom5Tree i
  else .inl 4

/-- All converse-preserving diversity-atom permutations. -/
noncomputable def renameDiversity (p : Fin 120) : DiversityAtom 5 0 → DiversityAtom 5 0
  | .inl 0 => renameAtom1 p
  | .inl 1 => renameAtom2 p
  | .inl 2 => renameAtom3 p
  | .inl 3 => renameAtom4 p
  | .inl 4 => renameAtom5 p

/-- Extend the diversity permutation by fixing the identity. -/
noncomputable def rename (p : Fin 120) : Atom 5 0 → Atom 5 0 :=
  Option.map (renameDiversity p)

/-- The atom maps are injective and preserve identity and converse. -/
theorem rename_laws : ∀ p, Function.Injective (rename p) ∧ rename p none = none ∧
    ∀ x, rename p x.converse = (rename p x).converse := by
  decide +kernel

/-- Every possible atom renaming occurs in the finite list. -/
theorem renamings_exhaustive : ∀ f : Atom 5 0 → Atom 5 0,
    Function.Injective f → f none = none →
      (∀ x, f x.converse = (f x).converse) → ∃ p : Fin 120, f = rename p := by
  exact renamings_exhaustive_of_atomPermutations rename (by decide +kernel)

