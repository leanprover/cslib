    (some (renameDiversity p (cycleReps i).1),
      some (renameDiversity p (cycleReps i).2.1),
      some (renameDiversity p (cycleReps i).2.2)) ∈
        cycleOrbit (cycleReps (orbitAction p i)) := by
  decide +kernel

